# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_LIFETIME=

# OpenAI
OPENAI_API_KEY=

# Mistral (fallback AI)
MISTRAL_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@send.cartacanta.app
RESEND_FROM_NAME=Carta Canta

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (captcha anti-bot sulla registrazione)
# Vuote = captcha disattivato (registrazione come oggi). Con le chiavi si attiva da solo.
# Site key: pubblica (client). Secret key: solo server. Da dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Flagsmith
NEXT_PUBLIC_FLAGSMITH_KEY=

# Sentry (monitoraggio errori) — vuote = Sentry disattivato (zero tracciamento).
# NEXT_PUBLIC_SENTRY_DSN attiva il lato browser, SENTRY_DSN il lato server.
# Basta lo stesso DSN del progetto Sentry in entrambe. (SENTRY_AUTH_TOKEN è
# opzionale, solo per l'upload delle source map — non necessario per iniziare.)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=https://cartacanta.app
NEXT_PUBLIC_APP_NAME=Carta Canta

# Password dell'account demo (scripts/seed-demo.ts) — SOLO qui, mai nel codice
DEMO_PASSWORD=

# TWA / Play Store — Digital Asset Links (vedi app/.well-known/assetlinks.json/route.ts)
TWA_SHA256_FINGERPRINT=
TWA_PACKAGE_NAME=
